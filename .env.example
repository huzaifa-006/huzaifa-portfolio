# Copy this file to `.env.local` for local development and fill in the values.
# Never commit `.env.local` — it is already in .gitignore.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Public URL of the deployed site (used for SEO: canonical URL, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://huzaifashafiq.vercel.app

# ── Contact form (server-side only — never prefix these with NEXT_PUBLIC_) ──
# Resend API key from https://resend.com/api-keys (starts with "re_"). Required for the form to send.
RESEND_API_KEY=
# Where contact-form messages are delivered. Defaults to huzaifashafiq2024@gmail.com if empty.
CONTACT_TO_EMAIL=
# Sender address. Leave empty to use Resend's shared "onboarding@resend.dev" sender, which only
# delivers to the email address that owns your Resend account. After verifying your own domain
# in Resend you can use e.g. "Portfolio <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=
