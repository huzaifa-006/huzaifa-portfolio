# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local` — it is already in .gitignore.

# Public URL of the deployed site (used for SEO: canonical URL, sitemap, Open Graph).
# Example: https://huzaifa-shafiq.vercel.app
NEXT_PUBLIC_SITE_URL=

# Contact form (optional). Get a free access key at https://web3forms.com
# (enter huzaifashafiq2024@gmail.com; the key is emailed to you).
# Web3Forms keys are designed to be used in the browser, so this is safe to expose.
# If left empty, the form opens the visitor's email app instead (still works).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Only for GitHub Pages project sites, e.g. /huzaifa-portfolio. Leave empty for Vercel.
NEXT_PUBLIC_BASE_PATH=
